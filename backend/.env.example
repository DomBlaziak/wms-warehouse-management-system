PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
# Dla aplikacji hostowanych na różnych domenach użyj COOKIE_SAME_SITE=none
# oraz COOKIE_SECURE=true (wymagany HTTPS).
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=baza_danych_inz
DB_PASSWORD=change_me_to_a_database_password
DB_USER=postgres

# Wygeneruj długi, losowy sekret i nie zapisuj prawdziwej wartości w repozytorium.
JWT_SECRET=change_me_to_a_long_random_secret
